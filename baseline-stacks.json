{
  "$comment": "Stacks a product can declare in its .baseline.json. The sync copies only the skills and the Claude Code hooks (files in .claude/hooks, with their .claude/settings.json entries) of the declared stacks and the stacks they require, and keeps only the AGENTS.md lines tagged with one of them; skills and hooks no stack claims are always copied, except the skills listed in \"baselineOnly\", which work on the baseline repository itself and are never copied. See docs/baseline/08-crosscutting-concepts/development/agent-skills.md#declared-stacks. \"detect\" (used only when a product has no .baseline.json yet): \"<component-folder-glob>/<file>[#<text the file must contain>]\".",
  "shared": [
    "baseline-tdd",
    "baseline-security",
    "baseline-i18n",
    "baseline-ide-setup"
  ],
  "baselineOnly": [
    "baseline-codebase-review"
  ],
  "stacks": {
    "java": {
      "requires": [],
      "skills": [
        "java-hibernate-jpa"
      ],
      "hooks": [],
      "detect": []
    },
    "spring": {
      "requires": [
        "java"
      ],
      "skills": [
        "baseline-spring",
        "spring-boot-testing",
        "spring-security",
        "spring-observability"
      ],
      "hooks": [
        "baseline-spring-reminder.mjs"
      ],
      "detect": [
        "backend*/pom.xml#spring-boot"
      ]
    },
    "typescript": {
      "requires": [],
      "skills": [
        "vitest",
        "orval",
        "accessibility",
        "playwright-best-practices",
        "playwright-cli"
      ],
      "hooks": [],
      "detect": []
    },
    "angular": {
      "requires": [
        "typescript"
      ],
      "skills": [
        "baseline-angular",
        "angular-developer",
        "angular-new-app",
        "angular-material-design",
        "ngrx-signals"
      ],
      "hooks": [
        "baseline-angular-reminder.mjs"
      ],
      "detect": [
        "frontend*/angular.json"
      ]
    },
    "node": {
      "requires": [],
      "skills": [
        "vitest"
      ],
      "hooks": [],
      "detect": []
    },
    "nestjs": {
      "requires": [
        "node"
      ],
      "skills": [
        "baseline-nestjs"
      ],
      "hooks": [
        "baseline-nestjs-reminder.mjs"
      ],
      "detect": [
        "backend*/package.json#@nestjs/core"
      ]
    },
    "react": {
      "requires": [
        "typescript"
      ],
      "skills": [
        "baseline-react",
        "vercel-react-best-practices",
        "tanstack-query-best-practices",
        "material-ui-theming",
        "material-ui-styling"
      ],
      "hooks": [
        "baseline-react-reminder.mjs"
      ],
      "detect": [
        "frontend*/vite.config.ts#@vitejs/plugin-react"
      ]
    },
    "nextjs": {
      "requires": [
        "react"
      ],
      "skills": [
        "baseline-nextjs"
      ],
      "hooks": [
        "baseline-nextjs-reminder.mjs"
      ],
      "detect": [
        "frontend*/next.config.ts"
      ]
    }
  }
}
