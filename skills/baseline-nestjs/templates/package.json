{
  "name": "orders-backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.13 <27",
    "npm": ">=11.10.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node --import ./dist/instrumentation.js dist/main.js",
    "start:dev": "nest start --watch --env-file .env.local",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:arch": "depcruise src",
    "test": "vitest run --project unit",
    "test:it": "vitest run --project it",
    "openapi": "OPENAPI_UPDATE=true vitest run --project unit openapi",
    "migrate": "node dist/migrate.js",
    "check:migrations": "node scripts/check-migrations.mjs",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run check:arch && npm run check:migrations && npm run test && npm run test:it && npm run build",
    "start:debug": "nest start --watch --debug --env-file .env.local"
  },
  "dependencies": {
    "@fastify/cors": "11.4.3",
    "@fastify/helmet": "13.2.0",
    "@fastify/otel": "1.0.1",
    "@nestjs/common": "12.5.0",
    "@nestjs/core": "12.5.0",
    "@nestjs/platform-fastify": "12.5.0",
    "@nestjs/schedule": "12.0.4",
    "@nestjs/swagger": "12.1.2",
    "@nestjs/terminus": "12.1.0",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/auto-instrumentations-node": "0.83.1",
    "@opentelemetry/instrumentation": "0.301.2",
    "@opentelemetry/sdk-node": "0.301.2",
    "cockatiel": "4.0.0",
    "import-in-the-middle": "3.6.0",
    "jose": "6.2.17",
    "kysely": "0.29.9",
    "nestjs-pino": "5.3.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "undici": "8.12.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/js": "9.39.5",
    "@nestjs/cli": "12.0.13",
    "@nestjs/testing": "12.5.0",
    "@standard-schema/spec": "1.0.0",
    "@swc/core": "1.16.22",
    "@testcontainers/postgresql": "12.2.1",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "dependency-cruiser": "18.7.2",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.18.1",
    "eslint-plugin-regexp": "3.3.3",
    "eslint-plugin-security": "4.2.1",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "jiti": "2.7.0",
    "pino-pretty": "13.2.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "unplugin-swc": "2.0.0",
    "vitest": "5.1.0",
    "vitest-mock-extended": "6.0.1",
    "yaml": "2.9.1"
  }
}
