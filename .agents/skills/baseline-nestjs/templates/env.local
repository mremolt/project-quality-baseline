# Throwaway local values matching compose.yaml and dev/postgres/init.sql (NEST-DEV-06); never a real secret.
AUTH_ISSUER=http://localhost:8180/realms/local
AUTH_AUDIENCE=orders-api
AUTH_JWKS_URI=http://localhost:8180/realms/local/protocol/openid-connect/certs
DATABASE_HOST=localhost
DATABASE_NAME=orders
# DML user of the application pool; DDL user for the start-up migration (NEST-DB-17, NEST-DEV-04)
DATABASE_USER=orders_app
DATABASE_PASSWORD=orders_app
DATABASE_MIGRATION_USER=orders_owner
DATABASE_MIGRATION_PASSWORD=orders_owner
LOG_LEVEL=debug
