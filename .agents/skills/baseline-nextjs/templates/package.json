  "scripts": {
    "generate:api": "orval",
    "dev": "npm run generate:api && next dev --hostname localhost",
    "dev:debug": "next dev --hostname localhost --inspect",
    "build": "npm run generate:api && next build",
    "start": "node .next/standalone/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:arch": "depcruise src",
    "check:bundle": "node scripts/check-bundle.mjs",
    "test": "npm run generate:api && vitest run",
    "e2e": "playwright test",
    "verify": "npm run generate:api && npm run format:check && npm run lint && npm run typecheck && npm run check:arch && npm run test && npm run build && npm run check:bundle"
  }
