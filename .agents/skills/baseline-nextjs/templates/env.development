# NEXT-DEV-03: local configuration, loaded by `next dev` only. Throwaway values that match compose.yaml and the
# stubs; no real secret. Personal overrides go into .env.development.local (gitignored).
APP_ENVIRONMENT_KIND=local
APP_TEST_STUBS=1
APP_ORIGIN=http://localhost:3000
API_BASE_URL=http://orders-backend.stub
OIDC_ISSUER_URL=https://idp.stub
OIDC_CLIENT_ID=shop
OIDC_CLIENT_SECRET=local-client-secret-not-real
REDIS_URL=redis://localhost:6379
ENVIRONMENT_NAME=local
ENVIRONMENT_LABEL=local
OTEL_SDK_DISABLED=true
