{
  "name": "orders-spa",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.0.0 <27",
    "npm": ">=11.10.0"
  },
  "dependencies": {
    "@emotion/cache": "11.14.0",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@hookform/resolvers": "7.0.6",
    "@mui/material": "9.5.0",
    "@mui/utils": "9.5.0",
    "@react-aria/live-announcer": "3.5.1",
    "@reduxjs/toolkit": "2.14.0",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-router": "1.170.46",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0",
    "react-redux": "9.3.1",
    "use-intl": "4.15.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@babel/core": "7.29.13",
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint-react/eslint-plugin": "5.30.2",
    "@eslint/js": "10.0.1",
    "@faker-js/faker": "10.6.0",
    "@playwright/test": "1.65.0",
    "@rolldown/plugin-babel": "0.3.1",
    "@tanstack/eslint-plugin-query": "5.107.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "axe-core": "4.14.0",
    "babel-plugin-react-compiler": "1.0.0",
    "dependency-cruiser": "18.7.2",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.18.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "jsdom": "31.0.1",
    "knip": "6.44.2",
    "msw": "3.0.5",
    "orval": "8.47.0",
    "playwright-core": "1.65.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "vitest-mock-extended": "6.0.1"
  },
  "scripts": {
    "generate:api": "orval --config orval.config.ts",
    "dev": "vite",
    "build": "npm run generate:api && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:arch": "depcruise src",
    "check:bundle": "node scripts/check-bundle.ts",
    "test": "npm run generate:api && vitest run",
    "test:coverage": "npm run generate:api && vitest run --coverage",
    "check:unused": "knip",
    "e2e": "playwright test --project=stubbed-*",
    "e2e:nightly": "playwright test --project=stubbed-* --project=nightly-*",
    "e2e:smoke": "playwright test --project=smoke",
    "check": "node scripts/verify.mjs generate:api! typecheck lint check:arch test",
    "verify": "node scripts/verify.mjs generate:api! format:check lint check:arch check:unused test build! check:bundle"
  }
}
